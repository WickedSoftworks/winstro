{
	"name": "ui",
	"version": "0.1.0",
	"private": true,
	"main": "electron/main.cjs",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "biome check",
		"format": "biome format --write",
		"electron:dev": "electron ./electron/main.cjs",
		"electron:prepare": "node ./scripts/prepare-electron.mjs",
		"dist:win": "bun run build && bun run electron:prepare && electron-builder --win nsis",
		"build:win": "electron-builder --win nsis"
	},
	"dependencies": {
		"@radix-ui/react-checkbox": "^1.3.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^0.563.0",
		"next": "16.1.6",
		"radix-ui": "^1.4.3",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"tailwind-merge": "^3.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.0",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"electron": "^41.2.2",
		"electron-builder": "^24.13.3",
		"shadcn": "^3.8.4",
		"tailwindcss": "^4",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5"
	},
	"ignoreScripts": [
		"sharp",
		"unrs-resolver"
	],
	"trustedDependencies": [
		"sharp",
		"unrs-resolver"
	],
	"build": {
		"appId": "com.wickedsoftworks.winstro",
		"productName": "winstro",
		"copyright": "Copyright © 2026 Wicked Softworks",
		"asar": true,
		"compression": "maximum",
		"directories": {
			"output": "release"
		},
		"files": [
			"electron/**/*",
			"package.json"
		],
		"extraResources": [
			{
				"from": "electron-dist/app-runtime",
				"to": "app-runtime"
			},
			{
				"from": "electron-dist/winstro-cli",
				"to": "winstro-cli"
			},
			{
				"from": "electron-dist/defaults",
				"to": "defaults"
			}
		],
		"win": {
			"target": [
				{
					"target": "nsis",
					"arch": [
						"x64"
					]
				}
			],
			"publisherName": "Wicked Softworks",
			"artifactName": "winstro-${version}-setup.${ext}"
		},
		"nsis": {
			"oneClick": false,
			"allowToChangeInstallationDirectory": true,
			"perMachine": false,
			"createDesktopShortcut": true,
			"createStartMenuShortcut": true,
			"shortcutName": "winstro"
		}
	}
}
